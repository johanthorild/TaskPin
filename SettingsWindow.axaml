<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TaskPin.SettingsWindow"
        Width="320" Height="240"
        Title="Settings"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        SystemDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Border Background="{StaticResource WindowBrush}"
          BorderBrush="#3FFFFFFF"
          BorderThickness="1"
          CornerRadius="7">
    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
      <TextBlock Grid.Row="0"
                 Text="Settings"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Margin="0,0,0,18"
                 PointerPressed="Header_PointerPressed" />

      <StackPanel Grid.Row="1" Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Opacity" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Slider Name="OpacitySlider" Minimum="0.65" Maximum="1" Width="120" />
            <TextBlock Name="OpacityValue" Width="32" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Start position" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" Name="PositionComboBox" Width="140">
            <ComboBoxItem Content="Top left" Tag="TopLeft" />
            <ComboBoxItem Content="Top right" Tag="TopRight" />
            <ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
            <ComboBoxItem Content="Bottom right" Tag="BottomRight" />
          </ComboBox>
        </Grid>
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" Click="Cancel_Click" />
        <Button Content="Save" Click="Save_Click" Background="{StaticResource AccentBrush}" Foreground="#FF10251E" />
      </StackPanel>
    </Grid>
  </Border>
</Window>